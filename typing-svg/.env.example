# Copy to .env and fill in. Deploy-time only -- the Worker needs no secrets at
# runtime.

# The single source of truth for the URL; not duplicated in wrangler.toml.
# In CI this is an Actions *variable*, not a secret: it is public.
WORKER_HOSTNAME=typing.zalanshah.com

# Cloudflare dash -> Workers & Pages -> "Account ID" in the right sidebar.
# (Also the 32-hex segment of the dash URL after dash.cloudflare.com/.)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dash -> My Profile -> API Tokens -> Create Token.
# "Edit Cloudflare Workers" template, scoped to this account and the
# zalanshah.com zone. A hand-rolled token needs Account / Workers Scripts /
# Edit, plus Zone / Workers Routes / Edit and Zone / DNS / Edit.
#
# Leave blank to deploy with an interactive `npx wrangler login` session
# instead — deploy.sh falls back to it automatically.
CLOUDFLARE_API_TOKEN=
